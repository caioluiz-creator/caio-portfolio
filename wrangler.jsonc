// Publicação do site na Cloudflare (Workers só com arquivos estáticos).
// O build é `npm run build`, que gera out/ pelo output: "export" do Next.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caiobiolink",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "caio.agenciarigor.com.br", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
